# Copy to .env.local for local development. Never commit .env.local.
#
# Every credential this site uses is read from the environment. When the client's
# real credentials arrive, set the same names in Vercel → Settings → Environment
# Variables and redeploy. No code changes are needed.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle. Never put a
# secret behind that prefix.
#
# The site keeps running with any secret missing. What stops working is listed
# next to each one.

# ------------------------------------------------------------------ public
# Leave UNSET in Vercel: canonical URLs, the sitemap and llms.txt then resolve
# to https://gogreensod.com. Only set it for local development.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sanity. Pin the API version to a date, never "latest".
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-06-01"

# ------------------------------------------------------------------ Stripe
# Production = live key. Preview and Development = test key (sk_test_…).
# No publishable key is needed: Checkout is a server-side redirect.

# Without it: the cart still works, but checkout is replaced by "call to order"
# and /api/checkout answers 503.
# Production should use a RESTRICTED key (rk_live_…) with one permission:
# Checkout Sessions → Write. Nothing else in Stripe is called.
STRIPE_SECRET_KEY=""

# Without it: /api/stripe/webhook refuses every request, so paid orders are not
# recorded in Studio. Payments are unaffected and remain in the Stripe Dashboard.
# Every endpoint has its own: the live endpoint, the test endpoint, and the local
# `stripe listen` CLI each print a different whsec_ value.
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------ Sanity
# Editor-role token: sanity.io/manage → API → Tokens → Add API token → Editor.
# Used only by the Stripe webhook to write orders.
# Without it: paid orders appear in the Stripe Dashboard but not in Studio.
SANITY_API_WRITE_TOKEN=""

# Shared with the Sanity webhook that refreshes pages when content is published.
# Without it: edits still go live, but within 60 seconds instead of instantly.
SANITY_REVALIDATE_SECRET=""

# Not used yet. Reserved for draft previews.
SANITY_API_READ_TOKEN=""

# ------------------------------------------------------------------ email (not built)
# Reserved for order emails. Sending from gogreensod.com needs DNS access for
# SPF, DKIM and DMARC, which the client has not provided yet.
RESEND_API_KEY=""
ORDER_FROM_EMAIL="orders@gogreensod.com"
ORDER_NOTIFICATION_EMAIL="gogreensod123@gmail.com"
