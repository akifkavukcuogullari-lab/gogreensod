# Copy to .env.local and fill in. Never commit .env.local.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle.
# Never put a secret behind that prefix.

# ---------------------------------------------------------------- public
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sanity (Phase 2). Pin the API version to a date, never "latest".
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-06-01"

# ---------------------------------------------------------------- secret
# Server only. Set these per-environment in Vercel:
# Production = live keys, Preview and Development = test keys.

# Stripe. No publishable key is needed — hosted Checkout redirects
# server-side. Prefer a restricted key in production, scoped to creating
# Checkout Sessions and reading line items.
STRIPE_SECRET_KEY=""

# Different value for every endpoint: Production, Preview, and the local
# `stripe listen` CLI each generate their own signing secret.
STRIPE_WEBHOOK_SECRET=""

# Sanity
SANITY_API_READ_TOKEN=""
SANITY_REVALIDATE_SECRET=""

# Resend. Domain must be verified (SPF + DKIM + DMARC) or delivery fails.
RESEND_API_KEY=""
ORDER_FROM_EMAIL="orders@gogreensod.com"
ORDER_NOTIFICATION_EMAIL="gogreensod123@gmail.com"
